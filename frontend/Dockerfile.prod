# Production image: builds the static app + a small Express server (server.ts) that
# serves it and proxies /api/* to BACKEND_URL at runtime — see server.ts for why a
# static-only host doesn't work here (ClusterIP-only backend, no Ingress).
# The dev Dockerfile (plain `vite --host`) is unrelated to this — used only by
# infra/docker-compose for local dev.

FROM node:20-slim AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM deps AS builder
WORKDIR /app
COPY . .
RUN npm run build

FROM node:20-slim AS prod-deps
WORKDIR /app
# Only server.ts's actual runtime deps — not a `package.json`-driven install, since
# `dependencies` there also (correctly) lists React/MUI/etc. for the Vite build, none of
# which the Node server imports (it only serves the already-bundled static JS). Keep the
# versions here in sync with package.json's express/http-proxy-middleware entries.
RUN npm install --no-save express@4.22.2 http-proxy-middleware@3.0.7

FROM node:20-slim
WORKDIR /app

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

ENV PORT=3000
EXPOSE 3000

CMD ["node", "dist/server.cjs"]
