# Copy this file to .env and fill in real values. .env is git-ignored — never commit
# real secrets. See docs/06-deployment-and-environments.md for the full contract.

# --- LLM (chat/completions) ---
LLM_PROVIDER=openai_compatible          # openai_compatible | bedrock
LLM_BASE_URL=                           # e.g. an OpenAI-compatible inference endpoint's /v1 base URL (dev currently uses nscale)
LLM_API_KEY=
LLM_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
LLM_REGION=                             # bedrock only, e.g. us-east-1

# --- Embeddings (local model, baked into the backend image at build time) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5
EMBEDDING_LOCAL_MODEL_PATH=/opt/models/bge-large-en-v1.5

# --- Database ---
DATABASE_URL=postgresql://sreagent:sreagent@postgres:5432/sreagent

# --- Auth ---
JWT_SECRET=
JWT_EXPIRY_MINUTES=1440
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Integrations (per-cluster/account config lives in DB `integration_scope`,
#     but base credentials/paths are env-driven) ---
AWS_REGION=
KUBECONFIG_PATH=
GRAFANA_BASE_URL=
GRAFANA_API_KEY=
PROMETHEUS_BASE_URL=
ALERTMANAGER_BASE_URL=

# --- Build-time only — NOT read by the running containers, see docs/06 §2a ---
# HUGGING_FACE_TOKEN=                   # passed to `docker build` as a BuildKit --secret, not as a normal env var
