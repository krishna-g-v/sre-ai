# Copy this file to .env and fill in real values. .env is git-ignored — never commit
# real secrets. See docs/06-deployment-and-environments.md for the full contract.

# --- LLM (chat/completions) ---
LLM_PROVIDER=openai_compatible          # openai_compatible | bedrock
LLM_BASE_URL=                           # e.g. an OpenAI-compatible inference endpoint's /v1 base URL (dev currently uses nscale)
LLM_API_KEY=
LLM_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
LLM_REGION=                             # bedrock only, e.g. us-east-1

# --- Embeddings (local model, baked into the backend image at build time) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5
EMBEDDING_LOCAL_MODEL_PATH=/opt/models/bge-large-en-v1.5

# --- Database ---
DATABASE_URL=postgresql+psycopg://sreagent:sreagent@postgres:5432/sreagent

# --- Auth ---
JWT_SECRET=
JWT_EXPIRY_MINUTES=1440
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Integrations (per-cluster/account config lives in DB `integration_scope`,
#     but base credentials/paths are env-driven) ---
AWS_REGION=
KUBECONFIG_PATH=
GRAFANA_BASE_URL=
GRAFANA_API_KEY=
PROMETHEUS_BASE_URL=
ALERTMANAGER_BASE_URL=

# --- AWS base identity (docs/10-nl-to-cli-execution.md §2/§9) ---
# The backend's own AWS identity — never used directly for anything, only to call
# sts:AssumeRole into each account/role a group (integration_scope) or user
# (user_aws_accounts, Settings -> AWS Accounts) has registered. Every such role's trust
# policy must list this identity's ARN as the trusted Principal. boto3 picks these up
# automatically from the environment — no app code reads them directly. In prod this is
# an IRSA role instead (no keys needed there); these are for local/dev only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=                      # only if the base identity itself is a temporary/assumed session

# --- Build-time only — NOT read by the running containers, see docs/06 §2a ---
# HUGGING_FACE_TOKEN=                   # passed to `docker build` as a BuildKit --secret, not as a normal env var
