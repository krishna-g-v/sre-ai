# Copy to .env and fill in real values for standalone (non-docker-compose) local dev.
# Using infra/docker-compose/ instead? Its own .env.example is the one that matters —
# this file is just for running the backend directly against your own Postgres.

# --- LLM (chat/completions) ---
LLM_PROVIDER=openai_compatible          # openai_compatible | bedrock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
LLM_REGION=

# --- Embeddings (local model) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5
EMBEDDING_LOCAL_MODEL_PATH=./models/bge-large-en-v1.5

# --- Database ---
DATABASE_URL=postgresql+psycopg://sreagent:sreagent@localhost:5432/sreagent

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRY_MINUTES=1440
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Integrations ---
AWS_REGION=
KUBECONFIG_PATH=
GRAFANA_BASE_URL=
GRAFANA_API_KEY=
PROMETHEUS_BASE_URL=
ALERTMANAGER_BASE_URL=

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173
